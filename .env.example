# Environment variables for agetor.
#
# Day-to-day development does not need any of these — defaults are fine.
# Copy this file to `.env` only if you need to override something (custom
# data dir, alternate agent binaries) or you're running the release pipeline
# locally as a maintainer.

# ─── Runtime overrides (optional) ─────────────────────────────────────────
# Override the bound port for the local HTTP API (default: 4317).
# AGETOR_API_PORT=4317

# Where the SQLite db, worktrees, and logs live. Defaults to ~/.agetor in
# packaged builds; `bun run dev` / `dev:hmr` set this to ~/.agetor-dev so
# in-progress migrations can't poison release state.
# AGETOR_DATA_DIR=

# Per-agent binary + arg overrides. Useful for testing against a different
# CLI install, or for substituting `/bin/echo` in tests.
# AGETOR_CLAUDE_BIN=
# AGETOR_CLAUDE_ARGS=
# AGETOR_CODEX_BIN=
# AGETOR_CODEX_ARGS=
# AGETOR_TMUX_BIN=

# Bypass tmux + the real claude CLI entirely (test-only).
# AGETOR_CLAUDE_DRIVER=fake

# ─── Release pipeline (maintainers only) ──────────────────────────────────
# CI handles this via GitHub Actions secrets — these are only needed if you
# run `bun run release` from your laptop. Do NOT commit real values.

# Apple Developer ID Application certificate identity, e.g.:
#   "Developer ID Application: Your Company (TEAMID123)"
# ELECTROBUN_DEVELOPER_ID=

# App Store Connect API key for notarization.
# ELECTROBUN_APPLEAPIKEY=          # key id (10 chars)
# ELECTROBUN_APPLEAPIISSUER=       # issuer uuid
# ELECTROBUN_APPLEAPIKEYPATH=      # absolute path to AuthKey_XXXX.p8

# Password used when exporting the Developer ID .p12 cert.
# DEVELOPER_ID_CERT_PASSWORD=

# Fine-grained PAT with `contents:write` on the release repo. Used by
# scripts/upload-release.ts to publish DMG + zip assets.
# GITHUB_TOKEN=
