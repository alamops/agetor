{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agetor.dev/schemas/remote/messages/challenge.json",
  "title": "challenge",
  "x-direction": "phone",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:~-]+$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "plan"
            },
            "taskId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            },
            "planId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            }
          },
          "required": [
            "kind",
            "taskId",
            "planId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "plan-edit"
            },
            "taskId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            },
            "planId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            },
            "body": {
              "type": "string",
              "maxLength": 262144
            }
          },
          "required": [
            "kind",
            "taskId",
            "planId",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "claude-plan"
            },
            "taskId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            },
            "promptId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            },
            "row": {
              "type": "string",
              "enum": [
                "auto",
                "manual"
              ]
            }
          },
          "required": [
            "kind",
            "taskId",
            "promptId",
            "row"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "tmux-card"
            },
            "taskId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            },
            "promptId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            }
          },
          "required": [
            "kind",
            "taskId",
            "promptId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "fx-permission"
            },
            "taskId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            },
            "permissionId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            }
          },
          "required": [
            "kind",
            "taskId",
            "permissionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "gate"
            },
            "taskId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            },
            "stepId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483648
            }
          },
          "required": [
            "kind",
            "taskId",
            "stepId",
            "seq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "fx-resume"
            },
            "taskId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            }
          },
          "required": [
            "kind",
            "taskId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "terminal"
            },
            "taskId": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            },
            "tmuxSession": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:~-]+$"
            }
          },
          "required": [
            "kind",
            "taskId",
            "tmuxSession"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "target"
  ],
  "additionalProperties": false
}
