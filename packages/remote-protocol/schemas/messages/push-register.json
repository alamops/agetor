{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agetor.dev/schemas/remote/messages/push-register.json",
  "title": "push-register",
  "x-direction": "phone",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:~-]+$"
    },
    "pushRef": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "sendKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "id",
    "pushRef",
    "sendKey"
  ],
  "additionalProperties": false
}
