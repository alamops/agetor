{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agetor.dev/schemas/remote/messages/terminal-closed.json",
  "title": "terminal-closed",
  "x-direction": "core",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:~-]+$"
    },
    "reason": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    }
  },
  "required": [
    "taskId",
    "reason"
  ],
  "additionalProperties": false
}
