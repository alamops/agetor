{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agetor.dev/schemas/remote/messages/challenge-issued.json",
  "title": "challenge-issued",
  "x-direction": "core",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:~-]+$"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "contentBytes": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "maxLength": 1398106
    },
    "contentHash": {
      "type": "string",
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799999
    }
  },
  "required": [
    "id",
    "challenge",
    "contentBytes",
    "contentHash",
    "expiresAt"
  ],
  "additionalProperties": false
}
